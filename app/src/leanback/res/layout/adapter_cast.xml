<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="44dp"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_metadata_card"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/MetadataCard" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/selector_metadata_tab_text"
        android:textSize="@dimen/tv_text_meta" />

    <!-- Role name without Douban's "饰 "/"配 " prefix; hidden when unknown. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/character"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/tvColorTextMuted"
        android:textSize="10sp"
        android:visibility="gone" />
</androidx.appcompat.widget.LinearLayoutCompat>
