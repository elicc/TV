<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="140dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/shape_vod_list"
    android:foreground="@drawable/selector_vod_grid"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/tvColorSurface"
        android:contentDescription="@string/metadata_artworks"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_artwork_ring"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />
</FrameLayout>
