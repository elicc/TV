<?xml version="1.0" ?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/textBoldSwitch" style="@style/TvDanmakuSwitch" android:text="@string/danmaku_text_bold"/>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_text_size"/>
        <com.google.android.material.slider.Slider android:id="@+id/textSizeSlider" style="@style/TvDanmakuSlider" android:valueFrom="0.5" android:valueTo="3.0" android:stepSize="0.1" android:contentDescription="@string/danmaku_text_size"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/textSizeValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_transparency"/>
        <com.google.android.material.slider.Slider android:id="@+id/alphaSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="0.9" android:stepSize="0.05" android:contentDescription="@string/danmaku_transparency"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/alphaValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow" android:addStatesFromChildren="false">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_style_mode"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/styleChipGroup" style="@style/TvDanmakuChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/styleNone" style="@style/TvDanmakuChip" android:text="@string/danmaku_style_none"/>
            <com.google.android.material.chip.Chip android:id="@+id/styleShadow" style="@style/TvDanmakuChip" android:text="@string/danmaku_style_shadow"/>
            <com.google.android.material.chip.Chip android:id="@+id/styleStroke" style="@style/TvDanmakuChip" android:text="@string/danmaku_style_stroke"/>
            <com.google.android.material.chip.Chip android:id="@+id/styleProjection" style="@style/TvDanmakuChip" android:text="@string/danmaku_style_projection"/>
        </com.google.android.material.chip.ChipGroup>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/shadowAlphaRow" style="@style/TvDanmakuRow" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel.Sub" android:text="@string/danmaku_shadow_transparency"/>
        <com.google.android.material.slider.Slider android:id="@+id/shadowAlphaSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="0.9" android:stepSize="0.05" android:contentDescription="@string/danmaku_shadow_transparency" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/shadowAlphaValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/strokeWidthRow" style="@style/TvDanmakuRow" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel.Sub" android:text="@string/danmaku_stroke_width"/>
        <com.google.android.material.slider.Slider android:id="@+id/strokeWidthSlider" style="@style/TvDanmakuSlider" android:valueFrom="0.05" android:valueTo="0.3" android:stepSize="0.01" android:contentDescription="@string/danmaku_stroke_width" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/strokeWidthValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/projectionOffsetXRow" style="@style/TvDanmakuRow" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel.Sub" android:text="@string/danmaku_projection_offset_x"/>
        <com.google.android.material.slider.Slider android:id="@+id/projectionOffsetXSlider" style="@style/TvDanmakuSlider" android:valueFrom="0.02" android:valueTo="0.15" android:stepSize="0.01" android:contentDescription="@string/danmaku_projection_offset_x" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/projectionOffsetXValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/projectionOffsetYRow" style="@style/TvDanmakuRow" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel.Sub" android:text="@string/danmaku_projection_offset_y"/>
        <com.google.android.material.slider.Slider android:id="@+id/projectionOffsetYSlider" style="@style/TvDanmakuSlider" android:valueFrom="0.02" android:valueTo="0.15" android:stepSize="0.01" android:contentDescription="@string/danmaku_projection_offset_y" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/projectionOffsetYValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/projectionAlphaRow" style="@style/TvDanmakuRow" android:visibility="gone">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel.Sub" android:text="@string/danmaku_projection_transparency"/>
        <com.google.android.material.slider.Slider android:id="@+id/projectionAlphaSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="0.9" android:stepSize="0.05" android:contentDescription="@string/danmaku_projection_transparency" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/projectionAlphaValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow" android:addStatesFromChildren="false">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_color_mode"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/colorChipGroup" style="@style/TvDanmakuChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/colorDefault" style="@style/TvDanmakuChip" android:text="@string/danmaku_color_default"/>
            <com.google.android.material.chip.Chip android:id="@+id/colorColorful" style="@style/TvDanmakuChip" android:text="@string/danmaku_color_colorful"/>
            <com.google.android.material.chip.Chip android:id="@+id/colorGradient" style="@style/TvDanmakuChip" android:text="@string/danmaku_color_gradient"/>
        </com.google.android.material.chip.ChipGroup>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.google.android.material.textview.MaterialTextView android:id="@+id/colorOverrideHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="2dp" android:paddingBottom="4dp" android:text="@string/danmaku_color_override_hint" android:textColor="?attr/tvColorWarning" android:textSize="@dimen/tv_text_meta" android:visibility="gone"/>
</androidx.appcompat.widget.LinearLayoutCompat>
