<?xml version="1.0" encoding="utf-8"?>
<!-- Single empty-source configuration entry card (VOD/Live/Drive variants). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/selector_empty_card"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:id="@+id/iconBox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/tv_empty_icon_box"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_error"
                app:tint="?attr/tvColorAccent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="?attr/tvColorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="点播数据源 (VOD)" />

                <TextView
                    android:id="@+id/tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/tv_tag_chip"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:textColor="?attr/tvColorFocus"
                    android:textSize="8sp"
                    android:visibility="gone"
                    tools:text="极速"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/tvColorTextPrimary"
                android:maxLines="1"
                android:textSize="9sp"
                tools:text="Spider API · 饭太硬 / 摸鱼 / 多多等接口" />

            <LinearLayout
                android:id="@+id/qrRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/tv_accent_dot_green"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/qrHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_empty_qr_hint"
                    android:textColor="?attr/tvColorFocus"
                    android:maxLines="1"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/qrUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/tv_qr_chip"
                    android:fontFeatureSettings="tnum"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:maxLines="1"
                    android:textColor="?attr/tvColorFocus"
                    android:textSize="6sp"
                    tools:text="http://192.168.x.x:9978" />
            </LinearLayout>

            <TextView
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/tvColorTextSecondary"
                android:textSize="8sp"
                tools:text="支持 JSON / M3U / TXT 链接快速推送" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/recommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="-7dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tv_recommended_badge"
        android:fontFamily="@font/space_grotesk"
        android:gravity="center_vertical"
        android:letterSpacing="0.06"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/tv_empty_recommended"
        android:textAllCaps="true"
        android:textColor="@android:color/black"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
