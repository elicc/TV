<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="152dp"
    android:clipChildren="false"
    android:clipToPadding="false">
    <com.fongmi.android.tv.ui.custom.FilmAtmosphereView
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <TextView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="-22dp"
        android:alpha="0.05"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textColor="?attr/tvColorTextPrimary"
        android:textSize="120sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="沙"
        tools:visibility="visible" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="324dp"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <FrameLayout
                android:id="@+id/badgeFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tv_hero_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:textColor="?attr/tvColorAccent"
                    android:textSize="@dimen/tv_text_caption"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="1080P"
                    tools:visibility="visible" />
                <com.fongmi.android.tv.ui.custom.ShimmerView
                    android:id="@+id/shimmer"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:rotation="-20"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/badgeFrame"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:textColor="?attr/tvColorTextSecondary"
                android:textAppearance="@style/TextAppearance.Tv.Meta"
                tools:text="科幻 / 冒险 · 2024" />
        </RelativeLayout>
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/tvColorTextPrimary"
            android:textAppearance="@style/TextAppearance.Tv.Hero"/>
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/tvColorTextSecondary"
            android:textAppearance="@style/TextAppearance.Tv.Body"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">
            <TextView
                android:id="@+id/primary" style="@style/Tv.HeroAction"
                android:background="@drawable/tv_hero_primary"
                android:drawableStart="@drawable/ic_hero_details"
                android:drawableTint="?attr/tvColorOnAccent"
                android:textColor="?attr/tvColorOnAccent"
                android:nextFocusRight="@id/secondary"/>
            <TextView
                android:id="@+id/secondary" style="@style/Tv.HeroAction"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_hero_library"
                android:drawableTint="@color/hero_secondary_text_color"
                android:textColor="@color/hero_secondary_text_color"
                android:nextFocusLeft="@id/primary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Stitch first-launch empty state lives in a dedicated presenter that
         owns its own slot in Home's vertical grid; Hero only renders real
         posters when the configuration exists. -->
</FrameLayout>
