<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="152dp"
    android:clipChildren="true">
    <com.fongmi.android.tv.ui.custom.FilmAtmosphereView
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/poster"
        android:layout_width="260dp"
        android:layout_height="152dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="40dp"
        android:padding="12dp"
        android:cropToPadding="true"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="324dp"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical">
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/tvColorTextPrimary"
            android:textAppearance="@style/TextAppearance.Tv.Hero"/>
        <TextView
            android:id="@+id/metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/tvColorTextSecondary"
            android:textAppearance="@style/TextAppearance.Tv.Meta"/>
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/tvColorTextSecondary"
            android:textAppearance="@style/TextAppearance.Tv.Body"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/primary" style="@style/Tv.HeroAction"
                android:background="@drawable/tv_hero_primary"
                android:textColor="?attr/tvColorOnAccent"
                android:nextFocusRight="@id/secondary"/>
            <TextView
                android:id="@+id/secondary" style="@style/Tv.HeroAction"
                android:layout_marginStart="8dp"
                android:nextFocusLeft="@id/primary"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
