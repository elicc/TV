<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true">
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/tvColorScrimStrong"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/tvColorTextPrimary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/tvColorTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="6dp"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@android:color/transparent" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/grid"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp" />

    </LinearLayout>
</FrameLayout>
