<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width playback drawer, aligned with the episode picker: actions first,
     then sources in one full-width column (single source) or two columns. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tvColorScrimStrong"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/search"
                style="@style/TvDanmakuPickerAction"
                android:drawableStart="@drawable/ic_nav_search"
                android:text="@string/tv_danmaku_search" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/choose"
                style="@style/TvDanmakuPickerAction"
                android:drawableStart="@drawable/ic_danmaku_local"
                android:text="@string/tv_danmaku_local" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/setting"
                style="@style/TvDanmakuPickerAction"
                android:drawableStart="@drawable/ic_nav_settings"
                android:text="@string/tv_danmaku_setting" />

            <TextView
                android:id="@+id/current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="?attr/tvColorTextSecondary"
                android:textSize="@dimen/tv_text_caption" />
        </LinearLayout>

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusableInTouchMode="true"
            android:padding="4dp"
            app:focusOutFront="true" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tv_danmaku_empty"
            android:textColor="?attr/tvColorTextSecondary"
            android:textSize="@dimen/tv_text_caption"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
