<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tvColorBackground">
    <com.fongmi.android.tv.ui.custom.AmbientGlowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <!-- Full-screen focused-poster backdrop. Sits below every row so the
         cover art can fill the entire viewport instead of being clipped
         to a single hero card. The atmosphere view is sourced from the
         currently-focused Vod / History card and follows D-pad focus. -->
    <com.fongmi.android.tv.ui.custom.FilmAtmosphereView
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="36dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/tv_safe_horizontal"
            android:paddingEnd="@dimen/tv_safe_horizontal">

            <!-- Brand: app icon + FONGMI wordmark + TV pill (Stitch design). -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="@string/app_name" />
                <TextView
                    android:id="@+id/brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="FONGMI"
                    android:textColor="?attr/tvColorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_vod_year"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="TV"
                    android:textColor="?attr/tvColorTextPrimary"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:id="@+id/navSpacer"
                android:layout_width="8dp"
                android:layout_height="1dp"
                android:layout_weight="0" />

            <!-- Single pill wrapping the visible destination items (Stitch design).
                 Container owns the glass background + 1dp inner stroke;
                 per-item selector paints only the active focus ring. -->
            <LinearLayout
                android:id="@+id/menuContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/tv_nav_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/navHome" style="@style/Tv.HomeNav"
                    android:visibility="gone"
                    android:letterSpacing="0.02"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_nav_home"
                    android:text="@string/tv_home" />
                <TextView
                    android:id="@+id/navVod" style="@style/Tv.HomeNav"
                    android:layout_marginStart="2dp"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/navSearch"
                    app:drawableStartCompat="@drawable/ic_nav_vod"
                    android:text="@string/home_vod" />
                <TextView
                    android:id="@+id/navLive" style="@style/Tv.HomeNav"
                    android:layout_marginStart="2dp"
                    app:drawableStartCompat="@drawable/ic_nav_live"
                    android:text="@string/home_live" />
                <TextView
                    android:id="@+id/navKeep" style="@style/Tv.HomeNav"
                    android:layout_marginStart="2dp"
                    app:drawableStartCompat="@drawable/ic_nav_keep"
                    android:text="@string/home_keep" />
                <TextView
                    android:id="@+id/navSearch" style="@style/Tv.HomeNav"
                    android:layout_marginStart="2dp"
                    app:drawableStartCompat="@drawable/ic_nav_search"
                    android:text="@string/home_search" />
                <TextView
                    android:id="@+id/more" style="@style/Tv.HomeNav"
                    android:layout_marginStart="2dp"
                    app:drawableStartCompat="@drawable/ic_nav_more"
                    android:text="@string/tv_more"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right cluster: source status pill + standalone gear icon button. -->
            <LinearLayout
                android:id="@+id/utilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/sourceRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/tv_source_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/navSearch"
                    android:nextFocusRight="@id/settings"
                    android:nextFocusDown="@id/recycler">
                    <View
                        android:id="@+id/sourceStatus"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/tv_source_status"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_source_unconfigured"
                        android:textColor="?attr/tvColorTextSecondary"
                        android:textAppearance="@style/TextAppearance.Tv.Meta"
                        android:textSize="8sp"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/settings"
                    style="@style/Tv.SettingsIconButton"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_nav_settings"
                    android:contentDescription="@string/home_setting" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="52dp"
                    android:gravity="center_vertical|end"
                    android:textColor="?attr/tvColorTextPrimary"
                    android:textAppearance="@style/TextAppearance.Tv.Clock" />
            </LinearLayout>
        </LinearLayout>

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.fongmi.android.tv.ui.custom.TvVerticalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/tv_safe_horizontal"
                android:paddingEnd="@dimen/tv_safe_horizontal"
                android:paddingBottom="@dimen/tv_safe_vertical"
                app:focusOutEnd="true"
                app:focusOutFront="true" />
        </com.fongmi.android.tv.ui.custom.ProgressLayout>

        <com.fongmi.android.tv.ui.custom.TvKeycapsBar
            android:id="@+id/keycaps"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_keycaps_bar_height"
            android:layout_marginBottom="@dimen/tv_keycaps_bottom_inset"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/tv_safe_horizontal"
            android:paddingEnd="@dimen/tv_safe_horizontal"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <!-- Cold-start brand splash. Opaque and above every other layer so the first
         frame the viewer sees is the brand artwork rather than an empty grid.
         HomeActivity raises it before the first activity frame and dissolves it into
         the home once the source config settles. Deliberately not focusable
         so it can never intercept a D-pad key from the home rows sitting behind it. -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_splash_backdrop"
        android:visibility="gone"
        android:importantForAccessibility="no">

        <!-- Brand artwork, already centre-cropped to 16:9 and vignetted offline by
             tools/brand/make_splash_backdrop.py. centerCrop keeps it covering on
             panels that are not exactly 16:9; the drawable only ever scales down
             from 1.06 to 1.0, so it can never pull inside its own bounds and
             expose the container behind it. -->
        <ImageView
            android:id="@+id/splashBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_splash_backdrop" />

        <!-- Mark and wordmark are one group so the exit can dissolve them ahead of the
             artwork, emptying the frame from the centre outward. -->
        <LinearLayout
            android:id="@+id/splashContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo_mark" />

            <TextView
                android:id="@+id/splashWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.22"
                android:text="FONGMI TV"
                android:textColor="@color/tv_splash_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
