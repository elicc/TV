<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/tvColorScrimStrong">
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/tvColorBackground">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name"/>
        <TextView
            android:id="@+id/navHome" style="@style/Tv.HomeNav"
            android:text="@string/tv_home"/>
        <TextView
            android:id="@+id/navVod" style="@style/Tv.HomeNav"
            android:text="@string/home_vod"/>
        <TextView
            android:id="@+id/navLive" style="@style/Tv.HomeNav"
            android:text="@string/home_live"/>
        <TextView
            android:id="@+id/navKeep" style="@style/Tv.HomeNav"
            android:text="@string/home_keep"/>
        <TextView
            android:id="@+id/navSearch" style="@style/Tv.HomeNav"
            android:text="@string/home_search"/>
        </LinearLayout>
        <Space
            android:id="@+id/navSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:id="@+id/utilities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title" style="@style/Tv.HomeNav"
            android:background="@drawable/selector_item"
            android:layout_width="140dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/tv_source"
            android:contentDescription="@string/tv_source"
            android:textAppearance="@style/TextAppearance.Tv.Meta"/>
        <TextView
            android:id="@+id/more" style="@style/Tv.HomeNav"
            android:text="@string/tv_more"/>
        <TextView
            android:id="@+id/settings" style="@style/Tv.HomeNav"
            android:text="@string/home_setting"/>
        <TextView
            android:id="@+id/clock"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="?attr/tvColorTextSecondary"
            android:textAppearance="@style/TextAppearance.Tv.Meta"/>
        </LinearLayout>
    </LinearLayout>
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.fongmi.android.tv.ui.custom.TvVerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true"/>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>
</LinearLayout>
