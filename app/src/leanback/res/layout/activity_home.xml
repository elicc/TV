<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/tvColorBackground">
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:background="?attr/tvColorBackground">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name"/>
        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="FONGMI"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_vod_year"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="TV"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/navHome" style="@style/Tv.HomeNav"
            android:text="@string/tv_home"/>
        <TextView
            android:id="@+id/navVod" style="@style/Tv.HomeNav"
            android:text="@string/home_vod"/>
        <TextView
            android:id="@+id/navLive" style="@style/Tv.HomeNav"
            android:text="@string/home_live"/>
        <TextView
            android:id="@+id/navKeep" style="@style/Tv.HomeNav"
            android:text="@string/home_keep"/>
        <TextView
            android:id="@+id/navSearch" style="@style/Tv.HomeNav"
            android:text="@string/home_search"/>
        </LinearLayout>
        <Space
            android:id="@+id/navSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:id="@+id/utilities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/sourceStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/tv_source_status"
                android:importantForAccessibility="no" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title" style="@style/Tv.HomeNav"
                android:background="@drawable/selector_item"
                android:layout_width="112dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/tv_source"
                android:contentDescription="@string/tv_source"
                android:textAppearance="@style/TextAppearance.Tv.Meta"/>
        </LinearLayout>
        <TextView
            android:id="@+id/more" style="@style/Tv.HomeNav"
            android:text="@string/tv_more"/>
        <TextView
            android:id="@+id/settings" style="@style/Tv.HomeNav"
            android:text="@string/home_setting"/>
        <TextView
            android:id="@+id/clock"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="?attr/tvColorTextSecondary"
            android:textAppearance="@style/TextAppearance.Tv.Meta"/>
        </LinearLayout>
    </LinearLayout>
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.fongmi.android.tv.ui.custom.TvVerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/tv_safe_horizontal"
            android:paddingEnd="@dimen/tv_safe_horizontal"
            android:paddingBottom="@dimen/tv_safe_vertical"
            app:focusOutEnd="true"
            app:focusOutFront="true"/>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>
    <TextView
        android:id="@+id/remoteHint"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:gravity="center_vertical"
        android:background="@color/tv_surface_low"
        android:text="@string/tv_home_remote_hint"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_caption"
        android:importantForAccessibility="no" />
</LinearLayout>
