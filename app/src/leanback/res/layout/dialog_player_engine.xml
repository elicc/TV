<?xml version="1.0" encoding="utf-8"?>
<!-- Docked playback drawer: compact header, then one row of engine choices. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvPlaybackDrawerHeader">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:text="@string/player_engine"
            style="@style/TvPlaybackDrawerTitle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_debug"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:src="@drawable/ic_action_debug" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/exo"
            style="@style/TvPlaybackDrawerChip"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_exo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mpv"
            style="@style/TvPlaybackDrawerChip"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_mpv" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/other"
            style="@style/TvPlaybackDrawerChip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_other" />


    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
