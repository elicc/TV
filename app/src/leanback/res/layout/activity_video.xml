<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.fongmi.android.tv.ui.custom.FilmAtmosphereView
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <com.fongmi.android.tv.ui.custom.FilmBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="420dp"
        android:layout_height="236dp"
        android:layout_marginTop="@dimen/tv_safe_vertical"
        android:layout_marginStart="@dimen/tv_safe_horizontal"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@color/black"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="@drawable/selector_video"
        android:contentDescription="@string/tv_playback_fullscreen_hint"
        android:nextFocusLeft="@id/video"
        android:nextFocusRight="@id/change"
        android:nextFocusUp="@id/video"
        android:nextFocusDown="@id/flag">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/row1"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_toEndOf="@+id/video"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/tvColorTextPrimary"
        android:textSize="@dimen/tv_text_section"
        tools:text="慶餘年第二季" />

    <com.fongmi.android.tv.ui.custom.SkeletonLayout
        android:id="@+id/skeletonMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/name"
        android:layout_above="@+id/row2"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_skeleton_bar"
            android:backgroundTint="?attr/tvColorSurfaceRaised" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <View
                android:layout_width="110dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_skeleton_bar"
                android:backgroundTint="?attr/tvColorSurfaceRaised" />

            <View
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_skeleton_bar"
                android:backgroundTint="?attr/tvColorSurfaceRaised" />

            <View
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_skeleton_bar"
                android:backgroundTint="?attr/tvColorSurfaceRaised" />

            <View
                android:layout_width="80dp"
                android:layout_height="16dp"
                android:background="@drawable/shape_skeleton_bar"
                android:backgroundTint="?attr/tvColorSurfaceRaised" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="300dp"
            android:layout_height="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_skeleton_bar"
            android:backgroundTint="?attr/tvColorSurfaceRaised" />

        <View
            android:layout_width="320dp"
            android:layout_height="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_skeleton_bar"
            android:backgroundTint="?attr/tvColorSurfaceRaised" />

        <View
            android:layout_width="260dp"
            android:layout_height="16dp"
            android:background="@drawable/shape_skeleton_bar"
            android:backgroundTint="?attr/tvColorSurfaceRaised" />
    </com.fongmi.android.tv.ui.custom.SkeletonLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/row1"
        android:layout_toEndOf="@+id/row1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:background="@drawable/shape_detail_tag"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_meta"
        tools:text="更新到第二季" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/metadataTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/actor"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabSource"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_metadata_tab"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/video"
            android:nextFocusDown="@id/description"
            android:text="@string/metadata_source"
            android:textColor="@color/selector_metadata_tab_text"
            android:textSize="@dimen/tv_text_button"
            android:stateListAnimator="@animator/tv_focus_scale"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabDouban"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_metadata_tab"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/video"
            android:nextFocusDown="@id/description"
            android:text="@string/metadata_douban"
            android:textColor="@color/selector_metadata_tab_text"
            android:textSize="@dimen/tv_text_button"
            android:stateListAnimator="@animator/tv_focus_scale"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabTmdb"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/selector_metadata_tab"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/video"
            android:nextFocusDown="@id/description"
            android:text="@string/metadata_tmdb"
            android:textColor="@color/selector_metadata_tab_text"
            android:textSize="@dimen/tv_text_button"
            android:stateListAnimator="@animator/tv_focus_scale"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/row1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/video"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/shape_detail_tag_primary"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/tvColorOnAccent"
            android:textSize="@dimen/tv_text_meta"
            tools:text="站源：泥巴" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/shape_detail_tag"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/tvColorTextSecondary"
            android:textSize="@dimen/tv_text_meta"
            tools:text="年份：2022" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/shape_detail_tag"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/tvColorTextSecondary"
            android:textSize="@dimen/tv_text_meta"
            tools:text="地區：台灣" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_detail_tag"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/tvColorTextSecondary"
            android:textSize="@dimen/tv_text_meta"
            tools:text="類型：科幻" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/director"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/name"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:nextFocusDown="@id/actor"
        android:drawableStart="@drawable/tv_accent_bar"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_meta"
        tools:text="導演：FongMi" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/actor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/director"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:drawableStart="@drawable/tv_accent_bar"
        android:drawablePadding="6dp"
        android:nextFocusDown="@id/description"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_meta"
        tools:text="演員：FongMi" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/metadataTabs"
        android:layout_above="@+id/row2"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:maxLines="3"
        android:nextFocusUp="@id/actor"
        android:nextFocusDown="@id/artworks"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_meta"
        android:visibility="gone"
        tools:text="影片简介文字显示在详情页中，最多展示三行，聚焦后可以展开查看完整内容。" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/descriptionMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/description"
        android:layout_above="@+id/row2"
        android:layout_alignStart="@+id/description"
        android:layout_marginTop="2dp"
        android:text="@string/tv_more"
        android:textColor="?attr/tvColorAccent"
        android:textSize="@dimen/tv_text_meta"
        android:visibility="gone" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/name"
        android:layout_alignBottom="@+id/video"
        android:clipChildren="false"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_item"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:stateListAnimator="@animator/tv_focus_scale"
            android:visibility="gone"
            android:gravity="center"
            android:nextFocusUp="@id/description"
            android:nextFocusDown="@id/artworks"
            android:ellipsize="end"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_detail_desc"
            android:drawablePadding="6dp"
            android:drawableTint="@color/selector_detail_action_icon"
            android:text="@string/detail_desc"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="@dimen/tv_text_button" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/change"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_item"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusRight="@id/keep"
            android:nextFocusUp="@id/description"
            android:nextFocusDown="@id/artworks"
            android:ellipsize="end"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_detail_change"
            android:drawablePadding="6dp"
            android:drawableTint="@color/selector_detail_action_icon"
            android:text="@string/play_change"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="@dimen/tv_text_button"
            android:stateListAnimator="@animator/tv_focus_scale"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/keep"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_item"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusLeft="@id/change"
            android:nextFocusUp="@id/description"
            android:nextFocusDown="@id/artworks"
            android:ellipsize="end"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_detail_keep_off"
            android:drawablePadding="6dp"
            android:drawableTint="@color/selector_detail_action_icon"
            android:text="@string/keep"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="@dimen/tv_text_button"
            android:stateListAnimator="@animator/tv_focus_scale"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/row2"
        android:layout_alignParentBottom="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <com.fongmi.android.tv.ui.custom.SkeletonLayout
                android:id="@+id/skeletonEpisode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/tv_safe_horizontal"
                android:paddingEnd="@dimen/tv_safe_horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_skeleton_bar"
                        android:backgroundTint="?attr/tvColorSurfaceRaised" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.fongmi.android.tv.ui.custom.SkeletonLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/artworkTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_safe_horizontal"
                android:layout_marginBottom="4dp"
                android:drawableStart="@drawable/tv_accent_bar"
                android:drawablePadding="6dp"
                android:text="@string/metadata_artworks"
                android:textColor="?attr/tvColorTextSecondary"
                android:textSize="@dimen/tv_text_meta"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/artworks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusUp="@id/description"
                android:nextFocusDown="@id/flag"
                android:paddingStart="@dimen/tv_safe_horizontal"
                android:paddingEnd="@dimen/tv_safe_horizontal"
                android:visibility="gone" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/flagRow"
                android:layout_width="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_safe_horizontal"
                android:layout_marginBottom="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/flagLabel"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/tv_accent_bar"
                    android:drawablePadding="6dp"
                    android:text="@string/detail_line"
                    android:textColor="?attr/tvColorTextSecondary"
                    android:textSize="@dimen/tv_text_meta" />

                <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/flag"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/tv_safe_horizontal"
                android:visibility="gone"
                tools:visibility="visible" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/qualityRow"
                android:layout_width="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_safe_horizontal"
                android:layout_marginBottom="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/qualityLabel"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/tv_accent_bar"
                    android:drawablePadding="6dp"
                    android:text="@string/detail_quality"
                    android:textColor="?attr/tvColorTextSecondary"
                    android:textSize="@dimen/tv_text_meta" />
                <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/quality"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/tv_safe_horizontal"
