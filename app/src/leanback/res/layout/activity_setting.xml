<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tvColorBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="@dimen/tv_safe_vertical"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/tv_setting_header_border"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settingBack"
            style="@style/Tv.Setting.Back"
            android:drawableStart="@drawable/ic_setting_back"
            android:nextFocusUp="@id/settingBack"
            android:nextFocusDown="@id/navContent"
            android:text="@string/tv_setting_back" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/tv_setting_breadcrumb"
            android:textColor="?attr/tvColorTextMuted"
            android:textSize="11sp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_action_setting"
            android:drawablePadding="6dp"
            android:drawableTint="?attr/tvColorAccent"
            android:gravity="center_vertical"
            android:text="@string/tv_setting_title"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/activeSourceText"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_setting_status_pill"
            android:drawableStart="@drawable/tv_setting_status_dot"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="225dp"
            android:singleLine="true"
            android:textColor="?attr/tvColorTextSecondary"
            android:textSize="10sp"
            tools:text="Active source · Example" />

        <TextClock
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:gravity="center_vertical|end"
            android:textColor="?attr/tvColorTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="222dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginBottom="7dp"
                android:text="@string/tv_setting_groups"
                android:textColor="?attr/tvColorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/navContent"
                style="@style/Tv.Setting.Nav"
                android:drawableStart="@drawable/ic_setting_nav_content"
                android:nextFocusLeft="@id/navContent"
                android:nextFocusUp="@id/settingBack"
                android:nextFocusRight="@id/vod"
                android:nextFocusDown="@id/navAppearance"
                android:text="@string/tv_setting_content" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/navAppearance"
                style="@style/Tv.Setting.Nav"
                android:drawableStart="@drawable/ic_setting_nav_appearance"
                android:nextFocusLeft="@id/navAppearance"
                android:nextFocusUp="@id/navContent"
                android:nextFocusRight="@id/skin"
                android:nextFocusDown="@id/navPlayback"
                android:text="@string/tv_setting_appearance" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/navPlayback"
                style="@style/Tv.Setting.Nav"
                android:drawableStart="@drawable/ic_setting_nav_playback"
                android:nextFocusLeft="@id/navPlayback"
                android:nextFocusUp="@id/navAppearance"
                android:nextFocusRight="@id/player"
                android:nextFocusDown="@id/navData"
                android:text="@string/tv_setting_playback" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/navData"
                style="@style/Tv.Setting.Nav"
                android:drawableStart="@drawable/ic_setting_nav_data"
                android:nextFocusLeft="@id/navData"
                android:nextFocusUp="@id/navPlayback"
                android:nextFocusRight="@id/incognito"
                android:nextFocusDown="@id/navAbout"
                android:text="@string/tv_setting_data" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/navAbout"
                style="@style/Tv.Setting.Nav"
                android:drawableStart="@drawable/ic_setting_nav_about"
                android:nextFocusLeft="@id/navAbout"
                android:nextFocusUp="@id/navData"
                android:nextFocusRight="@id/version"
                android:nextFocusDown="@id/navAbout"
                android:text="@string/tv_setting_about" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:id="@+id/settingsPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/tv_setting_panel_frame"
            android:clipChildren="true"
            android:clipToPadding="true">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:focusable="false"
                android:paddingStart="0dp"
                android:paddingTop="11dp"
                android:paddingEnd="0dp"
                android:paddingBottom="11dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingBottom="10dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Section"
                        android:text="@string/tv_setting_content_section" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/vod"
                            style="@style/Tv.Setting.Row"
                            android:layout_width="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:nextFocusLeft="@id/navContent"
                            android:nextFocusUp="@id/settingBack"
                            android:nextFocusRight="@id/vodHome"
                            android:nextFocusDown="@id/live">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Tv.Setting.RowTitle"
                                android:layout_width="wrap_content"
                                android:text="@string/setting_vod" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/vodUrl"
                                style="@style/Tv.Setting.RowValue"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                tools:text="https://" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/vodHome"
                            style="@style/Tv.Setting.IconAction"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/tv_setting_vod_home"
                            android:nextFocusLeft="@id/vod"
                            android:nextFocusUp="@id/settingBack"
                            android:nextFocusRight="@id/vodHistory"
                            android:nextFocusDown="@id/liveHome"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_setting_item_tint" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/vodHistory"
                            style="@style/Tv.Setting.IconAction"
                            android:contentDescription="@string/tv_setting_vod_history"
                            android:nextFocusLeft="@id/vodHome"
                            android:nextFocusUp="@id/settingBack"
                            android:nextFocusRight="@id/incognito"
                            android:nextFocusDown="@id/liveHistory"
                            android:src="@drawable/ic_setting_history"
                            android:tint="@color/tv_setting_item_tint" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/live"
                            style="@style/Tv.Setting.Row"
                            android:layout_width="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:nextFocusLeft="@id/navContent"
                            android:nextFocusUp="@id/vod"
                            android:nextFocusRight="@id/liveHome"
                            android:nextFocusDown="@id/doh">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Tv.Setting.RowTitle"
                                android:layout_width="wrap_content"
                                android:text="@string/setting_live" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/liveUrl"
                                style="@style/Tv.Setting.RowValue"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                tools:text="https://" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/liveHome"
                            style="@style/Tv.Setting.IconAction"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/tv_setting_live_home"
                            android:nextFocusLeft="@id/live"
                            android:nextFocusUp="@id/vodHome"
                            android:nextFocusRight="@id/liveHistory"
                            android:nextFocusDown="@id/doh"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_setting_item_tint" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/liveHistory"
                            style="@style/Tv.Setting.IconAction"
                            android:contentDescription="@string/tv_setting_live_history"
                            android:nextFocusLeft="@id/liveHome"
                            android:nextFocusUp="@id/vodHistory"
                            android:nextFocusRight="@id/incognito"
                            android:nextFocusDown="@id/doh"
                            android:src="@drawable/ic_setting_history"
                            android:tint="@color/tv_setting_item_tint" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/doh"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/navContent"
                        android:nextFocusUp="@id/live"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/skin">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:layout_width="wrap_content"
                            android:text="@string/setting_doh" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/dohText"
                            style="@style/Tv.Setting.RowValue"
                            tools:text="System" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sectionAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Section"
                        android:text="@string/tv_setting_appearance_section" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/skin"
                        style="@style/Tv.Setting.Row"
                        android:nextFocusLeft="@id/navAppearance"
                        android:nextFocusUp="@id/doh"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/atmosphere">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/tv_setting_skin" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/skinText"
                            style="@style/Tv.Setting.RowValue" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Hint"
                        android:text="@string/tv_setting_skin_hint" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/atmosphere"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/navAppearance"
                        android:nextFocusUp="@id/skin"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/wall">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/tv_setting_atmosphere" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/atmosphereText"
                            style="@style/Tv.Setting.RowValue" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Hint"
                        android:text="@string/tv_setting_atmosphere_hint" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/wall"
                            style="@style/Tv.Setting.Row"
                            android:layout_width="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:nextFocusLeft="@id/navAppearance"
                            android:nextFocusUp="@id/atmosphere"
                            android:nextFocusRight="@id/wallDefault"
                            android:nextFocusDown="@id/size">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Tv.Setting.RowTitle"
                                android:layout_width="wrap_content"
                                android:text="@string/setting_wall" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/wallUrl"
                                style="@style/Tv.Setting.RowValue"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                tools:text="Built-in" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/wallDefault"
                            style="@style/Tv.Setting.IconAction"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/tv_setting_wall_default"
                            android:nextFocusLeft="@id/wall"
                            android:nextFocusUp="@id/atmosphere"
                            android:nextFocusRight="@id/wallRefresh"
                            android:nextFocusDown="@id/size"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_setting_item_tint" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/wallRefresh"
                            style="@style/Tv.Setting.IconAction"
                            android:contentDescription="@string/tv_setting_wall_refresh"
                            android:nextFocusLeft="@id/wallDefault"
                            android:nextFocusUp="@id/atmosphere"
                            android:nextFocusRight="@id/incognito"
                            android:nextFocusDown="@id/size"
                            android:src="@drawable/ic_setting_refresh"
                            android:tint="@color/tv_setting_item_tint" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/size"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/navAppearance"
                        android:nextFocusUp="@id/wall"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/player">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:layout_width="wrap_content"
                            android:text="@string/setting_size" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/sizeText"
                            style="@style/Tv.Setting.RowValue"
                            tools:text="Medium" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sectionPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Section"
                        android:text="@string/tv_setting_playback_section" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/player"
                        style="@style/Tv.Setting.Row"
                        android:nextFocusLeft="@id/navPlayback"
                        android:nextFocusUp="@id/size"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/danmaku">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/setting_player" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/danmaku"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/navPlayback"
                        android:nextFocusUp="@id/player"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/danmaku">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/setting_danmaku" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/utilityPanel"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="@drawable/tv_setting_panel_frame"
            android:clipChildren="true"
            android:clipToPadding="true">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/utilityScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:focusable="false"
                android:paddingStart="0dp"
                android:paddingTop="11dp"
                android:paddingEnd="0dp"
                android:paddingBottom="11dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingBottom="10dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sectionData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Section"
                        android:text="@string/tv_setting_utility_section" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/incognito"
                        style="@style/Tv.Setting.Row"
                        android:nextFocusLeft="@id/doh"
                        android:nextFocusUp="@id/settingBack"
                        android:nextFocusRight="@id/incognito"
                        android:nextFocusDown="@id/vault">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/setting_incognito" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/incognitoText"
                            style="@style/Tv.Setting.RowValue"
                            android:layout_width="wrap_content"
                            tools:text="Off" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <!-- Automatic backup into /storage/emulated/0/TV, the one location that
                         outlives an uninstall. Its value text is the honest status of that
                         mechanism, which is the only place a write failure becomes visible. -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/vault"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/player"
                        android:nextFocusUp="@id/incognito"
                        android:nextFocusRight="@id/vault"
                        android:nextFocusDown="@id/backup">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/tv_vault_row" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vaultText"
                            style="@style/Tv.Setting.RowValue"
                            android:layout_width="wrap_content"
                            tools:text="已开启 · 09-15 12:30" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/backup"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/player"
                        android:nextFocusUp="@id/vault"
                        android:nextFocusRight="@id/backup"
                        android:nextFocusDown="@id/restore">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/setting_backup" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/restore"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/player"
                        android:nextFocusUp="@id/backup"
                        android:nextFocusRight="@id/restore"
                        android:nextFocusDown="@id/cache">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:text="@string/setting_restore" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/cache"
                        style="@style/Tv.Setting.Row"
                        android:layout_marginTop="5dp"
                        android:nextFocusLeft="@id/player"
                        android:nextFocusUp="@id/restore"
                        android:nextFocusRight="@id/cache"
                        android:nextFocusDown="@id/version">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/tv_setting_clear_cache" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/cacheText"
                            style="@style/Tv.Setting.RowValue"
                            android:layout_width="wrap_content"
                            tools:text="1.0 MB" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sectionAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Tv.Setting.Section"
                        android:text="@string/tv_setting_about_section" />
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/version"
                        style="@style/Tv.Setting.Row"
                        android:nextFocusLeft="@id/navAbout"
                        android:nextFocusUp="@id/cache"
                        android:nextFocusRight="@id/version"
                        android:nextFocusDown="@id/version">
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Tv.Setting.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/setting_version" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/versionText"
                            style="@style/Tv.Setting.RowValue"
                            android:layout_width="wrap_content"
                            tools:text="1.2.1" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="42dp"
                        android:background="@drawable/tv_setting_help_card"
                        android:text="@string/tv_setting_remote_help"
                        android:textColor="?attr/tvColorTextSecondary"
                        android:textSize="10sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.fongmi.android.tv.ui.custom.TvKeycapsBar
        android:id="@+id/keycaps"
        android:layout_width="match_parent"
        android:layout_height="29dp"
        android:background="@drawable/tv_setting_footer_border"
        android:gravity="center_vertical"
        android:importantForAccessibility="no" />
</androidx.appcompat.widget.LinearLayoutCompat>
