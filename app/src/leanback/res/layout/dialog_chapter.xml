<?xml version="1.0" encoding="utf-8"?>
<!-- Docked playback drawer: compact header, then a 3-column grid of choices. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvPlaybackDrawerHeader">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:text="@string/dialog_select_chapter"
            style="@style/TvPlaybackDrawerTitle"
            android:layout_width="0dp"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        style="@style/TvPlaybackDrawerList"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/adapter_chapter" />

</androidx.appcompat.widget.LinearLayoutCompat>
