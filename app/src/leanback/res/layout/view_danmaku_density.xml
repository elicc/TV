<?xml version="1.0" ?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_max_on_screen"/>
        <com.google.android.material.slider.Slider android:id="@+id/maxOnScreenSlider" style="@style/TvDanmakuSlider" android:valueFrom="10" android:valueTo="500" android:stepSize="10" android:contentDescription="@string/danmaku_max_on_screen"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/maxOnScreenValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_scroll_area_ratio"/>
        <com.google.android.material.slider.Slider android:id="@+id/scrollAreaSlider" style="@style/TvDanmakuSlider" android:valueFrom="0.1" android:valueTo="1.0" android:stepSize="0.05" android:contentDescription="@string/danmaku_scroll_area_ratio"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/scrollAreaValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_scroll_gap_ratio"/>
        <com.google.android.material.slider.Slider android:id="@+id/scrollGapSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="5.0" android:stepSize="0.1" android:contentDescription="@string/danmaku_scroll_gap_ratio"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/scrollGapValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_line_spacing"/>
        <com.google.android.material.slider.Slider android:id="@+id/lineSpacingSlider" style="@style/TvDanmakuSlider" android:valueFrom="1.0" android:valueTo="2.0" android:stepSize="0.1" android:contentDescription="@string/danmaku_line_spacing"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/lineSpacingValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/maxScrollLinesRow" style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_max_scroll_lines"/>
        <com.google.android.material.slider.Slider android:id="@+id/maxScrollLinesSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="20" android:stepSize="1" android:contentDescription="@string/danmaku_max_scroll_lines"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/maxScrollLinesValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/maxTopLinesRow" style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_max_top_lines"/>
        <com.google.android.material.slider.Slider android:id="@+id/maxTopLinesSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="10" android:stepSize="1" android:contentDescription="@string/danmaku_max_top_lines"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/maxTopLinesValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat android:id="@+id/maxBottomLinesRow" style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_max_bottom_lines"/>
        <com.google.android.material.slider.Slider android:id="@+id/maxBottomLinesSlider" style="@style/TvDanmakuSlider" android:valueFrom="0" android:valueTo="10" android:stepSize="1" android:contentDescription="@string/danmaku_max_bottom_lines"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/maxBottomLinesValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
