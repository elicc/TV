<?xml version="1.0" encoding="utf-8"?>
<!-- Docked playback drawer: compact header, keyword + API on one row, two-column results. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvPlaybackDrawerHeader">

        <com.google.android.material.textview.MaterialTextView
            style="@style/TvPlaybackDrawerTitle"
            android:layout_width="wrap_content"
            android:text="@string/tv_danmaku_search" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TvPlaybackDrawerTitle"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/tv_danmaku_search_hint"
            android:textColor="?attr/tvColorTextMuted"
            android:textSize="@dimen/tv_text_meta" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/keyword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/selector_detail_choice"
            android:hint="@string/search_keyword"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
            android:maxLength="255"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="?attr/tvColorTextPrimary"
            android:textColorHint="?attr/tvColorTextSecondary"
            android:textSize="@dimen/tv_text_body" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/settingAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/setting"
                style="@style/TvDanmakuPickerAction"
                android:layout_height="40dp"
                android:contentDescription="@string/tv_danmaku_api"
                android:drawableStart="@drawable/ic_nav_settings"
                android:text="@string/tv_danmaku_api" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/tvColorAccent"
        app:indicatorSize="28dp"
        app:trackThickness="2dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@android:id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/tvColorTextSecondary"
        android:textSize="@dimen/tv_text_caption"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        style="@style/TvPlaybackDrawerList"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:listitem="@layout/adapter_danmaku" />

</androidx.appcompat.widget.LinearLayoutCompat>
