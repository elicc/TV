<?xml version="1.0" ?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_time_offset"/>
        <com.google.android.material.slider.Slider android:id="@+id/timeOffsetSlider" style="@style/TvDanmakuSlider" android:valueFrom="-300000" android:valueTo="300000" android:stepSize="1000" android:contentDescription="@string/danmaku_time_offset"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/timeOffsetValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_duration"/>
        <com.google.android.material.slider.Slider android:id="@+id/durationSlider" style="@style/TvDanmakuSlider" android:valueFrom="3000" android:valueTo="15000" android:stepSize="500" android:contentDescription="@string/danmaku_duration"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/durationValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat style="@style/TvDanmakuRow">
        <com.google.android.material.textview.MaterialTextView style="@style/TvDanmakuLabel" android:text="@string/danmaku_fixed_duration"/>
        <com.google.android.material.slider.Slider android:id="@+id/fixedDurationSlider" style="@style/TvDanmakuSlider" android:valueFrom="2000" android:valueTo="10000" android:stepSize="500" android:contentDescription="@string/danmaku_fixed_duration"/>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/fixedDurationValue" style="@style/TvDanmakuValue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
