<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/shape_controller"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_horizontal"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/tv_safe_horizontal"
    android:paddingBottom="@dimen/tv_safe_vertical">

    <androidx.media3.ui.PlayerSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <include
        android:id="@+id/action"
        layout="@layout/view_control_live_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</androidx.appcompat.widget.LinearLayoutCompat>
