<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tv.HomeNav" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center_vertical</item>
        <!-- Keep the five tabs compact like the Stitch pill; the 20dp Lucide
             icon remains the visual anchor while the labels stay readable. -->
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
        <item name="android:background">@drawable/tv_nav_pill</item>
        <item name="android:textColor">@color/nav_text_color</item>
        <item name="android:textAppearance">@style/TextAppearance.Tv.Navigation</item>
        <item name="android:textSize">10sp</item>
        <!-- Vector icon plumbing: the nav TextView carries its own drawableStart
             so focus/click/scale stays on a single view (no ImageView nesting).
             The tint list mirrors the text color state list. -->
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/nav_icon_color</item>
    </style>

    <style name="Tv.SettingsIconButton" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">5dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/tv_settings_pill</item>
        <item name="android:drawableTint">?attr/tvColorTextPrimary</item>
        <item name="android:duplicateParentState">false</item>
    </style>
    <style name="Tv.HeroAction" parent="Tv.HomeNav">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/selector_item</item>
    </style>
</resources>
