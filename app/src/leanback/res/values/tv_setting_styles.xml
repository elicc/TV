<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tv.Setting.Back" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
        <item name="android:textColor">?attr/tvColorTextPrimary</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tv.Setting.Nav" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
        <item name="android:textColor">?attr/tvColorTextPrimary</item>
        <item name="android:textSize">@dimen/tv_text_card_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tv.Setting.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/tvColorAccent</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tv.Setting.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:clipChildren">false</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
    </style>

    <style name="Tv.Setting.IconAction" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
    </style>

    <style name="Tv.Setting.RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">?attr/tvColorTextPrimary</item>
        <item name="android:textSize">@dimen/tv_text_card_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tv.Setting.RowValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/tvColorTextSecondary</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
    </style>

    <style name="Tv.Setting.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">?attr/tvColorTextSecondary</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
    </style>
</resources>
