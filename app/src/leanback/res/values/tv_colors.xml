<resources>
    <!-- Champagne Dark v1.2. Keep compatibility aliases for existing layouts. -->
    <color name="tv_bg">#0E0E10</color>
    <color name="tv_background">@color/tv_bg</color>
    <color name="tv_surface">#202024</color>
    <color name="tv_surface_low">#161619</color>
    <color name="tv_surface_high">#2A2A30</color>
    <color name="tv_surface_raised">@color/tv_surface_high</color>
    <color name="tv_text_primary">#F3F3F6</color>
    <color name="tv_text_secondary">#9B9BA1</color>
    <color name="tv_text_muted">#66666D</color>
    <color name="tv_text_disabled">#545458</color>
    <color name="tv_accent">#E5A958</color>
    <color name="tv_accent_champagne">@color/tv_accent</color>
    <color name="tv_accent_ice">#6FA8FF</color>
    <color name="tv_accent_jade">#6CC4A1</color>
    <color name="tv_on_accent">#0E0E10</color>
    <color name="tv_focus">#FCD58B</color>
    <color name="tv_focus_ice">#B8E0FF</color>
    <color name="tv_focus_jade">#B8E8D2</color>
    <!-- Focus halo band at ~28% alpha; drawable-only approximation of the 25px blur. -->
    <color name="tv_focus_glow_champagne">#47FCD58B</color>
    <color name="tv_focus_glow_ice">#47B8E0FF</color>
    <color name="tv_focus_glow_jade">#47B8E8D2</color>
    <!-- Glass surfaces below API 31 fall back to an opaque-enough tint instead of blur. -->
    <color name="tv_glass">#D1202024</color>
    <color name="tv_glass_raised">#F22A2A30</color>
    <color name="tv_glass_border">#14FFFFFF</color>
    <!-- Top navigation, translated directly from code.html:
         bg-white/5, border-white/10, selected bg-white/10 and border-white/15. -->
    <!-- Opaque rendered equivalents sampled from the checked-in Stitch screen.
         Using the raw translucent CSS values here compounded twice through the
         View backgrounds and made Android visibly brighter than the reference. -->
    <color name="tv_nav_surface">#FF121213</color>
    <color name="tv_nav_border">#FF1C1C1D</color>
    <color name="tv_nav_selected">#FF232324</color>
    <color name="tv_nav_selected_border">#FF2E2E30</color>
    <color name="tv_nav_text_focused">#FFF3F3F6</color>
    <color name="tv_nav_text_inactive">#FF66666D</color>
    <!-- Subtle borders on empty/empty-state cards per the Stitch empty_source design. -->
    <color name="tv_border_subtle">#2E2E35</color>
    <!-- Accent tints used by empty-state badge pills (25% / 50% alpha variants). -->
    <color name="tv_accent_quarter">#40E5A958</color>
    <color name="tv_accent_half">#80E5A958</color>
    <color name="tv_selected_champagne">#3D3328</color>
    <color name="tv_selected_ice">#273845</color>
    <color name="tv_selected_jade">#273E35</color>
    <color name="tv_outline">#33E5A958</color>
    <color name="tv_scrim">#CC0E0E10</color>
    <color name="tv_scrim_strong">#E60E0E10</color>
    <color name="tv_success">#22C55E</color>
    <color name="tv_danger">#EF4444</color>
    <color name="tv_live_red">#EF4444</color>
    <color name="tv_error">@color/tv_danger</color>
    <color name="tv_warning">#F59E0B</color>
    <!-- Cold-start splash is the one light surface in an otherwise dark theme. It is a
         fixed brand moment rather than a themed surface, so it is deliberately plain
         @color and not routed through a ?attr/ token. -->
    <color name="tv_splash_backdrop">#F3EAE6</color>
    <!-- Slate-indigo sampled from the shadowed face of the brand ribbon. The old
         tvColorTextSecondary (#9B9BA1) only reached 2.4:1 on the light backdrop. -->
    <color name="tv_splash_ink">#333F5C</color>
</resources>
