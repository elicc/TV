<?xml version="1.0" encoding="utf-8"?>
<!-- Playback drawers docked above the fullscreen console share the danmaku picker's
     compact header and the episode-chip item treatment (selected = underline). -->
<resources>
    <style name="TvPlaybackDrawerHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="TvPlaybackDrawerTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?attr/tvColorTextSecondary</item>
        <item name="android:textSize">@dimen/tv_text_caption</item>
    </style>
    <style name="TvPlaybackDrawerList">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="maxHeight">@dimen/tv_playback_drawer_list_max_height</item>
    </style>
    <style name="TvPlaybackDrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/tv_danmaku_choice_height</item>
        <item name="android:background">@drawable/selector_detail_choice</item>
        <item name="android:foreground">@drawable/selector_detail_choice_indicator_overlay</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/selector_flag_choice_text</item>
        <item name="android:textSize">@dimen/tv_text_caption</item>
    </style>
    <style name="TvPlaybackDrawerChip" parent="TvPlaybackDrawerItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:maxWidth">@dimen/tv_choice_max_width</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- Danmaku search drawer: label column, then a row of chips. -->
    <style name="TvDanmakuFinderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="TvDanmakuFinderLabel">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/tvColorTextMuted</item>
        <item name="android:textSize">@dimen/tv_text_meta</item>
    </style>
    <style name="TvDanmakuFinderStep" parent="TvPlaybackDrawerChip">
        <item name="android:minWidth">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:drawableTint">@color/tv_danmaku_action_content</item>
    </style>
</resources>
