<?xml version="1.0" encoding="utf-8"?>
<!-- Resting labels use the design's dark gray; keyboard focus raises only
     the label contrast. Icon focus color is handled independently. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/tv_nav_text_focused" />
    <item android:color="@color/tv_nav_text_inactive" />
</selector>
