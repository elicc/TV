<?xml version="1.0" encoding="utf-8"?>
<!-- Color state list for top-nav item text.
     Drives both textColor and drawableTint (via separate list in nav_icon_color.xml). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/tvColorOnAccent" />
    <item android:state_selected="true" android:color="?attr/tvColorTextPrimary" />
    <item android:color="?attr/tvColorTextSecondary" />
</selector>
