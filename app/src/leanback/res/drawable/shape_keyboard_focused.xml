<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring with an inner champagne halo stroke (search keyboard key). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurface" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="@dimen/tv_glow_band" android:color="?attr/tvColorFocusGlow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
</layer-list>
