<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring with an inner champagne halo stroke (search keyboard key). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/tvColorSurface" />
    <corners android:radius="@dimen/tv_radius_control" />
    <stroke
        android:width="@dimen/tv_glow_band"
        android:color="?attr/tvColorFocusGlow" />
    <stroke
        android:width="@dimen/tv_focus_width"
        android:color="?attr/tvColorFocus" />
</shape>