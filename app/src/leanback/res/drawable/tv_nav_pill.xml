<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation pill with a single precision focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_nav_selected" />
            <corners android:radius="999dp" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_nav_selected" />
            <corners android:radius="999dp" />
            <stroke android:width="0.5dp" android:color="@color/tv_nav_selected_border" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
