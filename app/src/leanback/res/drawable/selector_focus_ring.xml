<?xml version="1.0" encoding="utf-8"?>
<!-- Inner poster ring shown while the card itself is focused (duplicateParentState). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_card" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
