<?xml version="1.0" encoding="utf-8"?>
<!-- Setting rows stay flat on the sheet; a row lights up when it or the
     slider inside it holds focus (rows use addStatesFromChildren). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurfaceRaised" />
            <corners android:radius="8dp" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
