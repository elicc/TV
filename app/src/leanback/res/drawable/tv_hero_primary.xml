<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true">
        <shape>
            <solid
                android:color="?attr/tvColorAccent"/>
            <corners
                android:radius="@dimen/tv_radius_control"/>
            <stroke
                android:width="@dimen/tv_focus_width"
                android:color="?attr/tvColorFocus"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid
                android:color="?attr/tvColorAccent"/>
            <corners
                android:radius="@dimen/tv_radius_control"/>
        </shape>
    </item>
</selector>
