<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true">
        <shape>
            <solid
                android:color="?attr/tvColorSurfaceRaised"/>
            <corners
                android:radius="@dimen/tv_radius_control"/>
            <stroke
                android:width="@dimen/tv_focus_width"
                android:color="?attr/tvColorFocus"/>
        </shape>
    </item>
    <item
        android:state_selected="true">
        <layer-list>
            <item
                android:gravity="bottom"
                android:height="2dp"
                android:left="12dp"
                android:right="12dp">
                <shape>
                    <solid
                        android:color="?attr/tvColorAccent"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item
        android:drawable="@android:color/transparent"/>
</selector>
