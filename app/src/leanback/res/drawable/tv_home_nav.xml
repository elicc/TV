<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true">
        <shape>
            <solid
                android:color="?attr/tvColorSurfaceRaised"/>
            <corners
                android:radius="@dimen/tv_radius_control"/>
            <stroke
                android:width="@dimen/tv_focus_width"
                android:color="?attr/tvColorFocus"/>
        </shape>
    </item>
    <item
        android:state_selected="true">
        <shape>
            <solid android:color="?attr/tvColorSurfaceRaised" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="1dp" android:color="?attr/tvColorOutline" />
        </shape>
    </item>
    <item
        android:drawable="@android:color/transparent"/>
</selector>
