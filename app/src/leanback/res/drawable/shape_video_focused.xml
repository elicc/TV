<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring with an inner champagne halo stroke (full-bleed video window). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="@dimen/tv_glow_band"
        android:color="?attr/tvColorFocusGlow" />
    <stroke
        android:width="@dimen/tv_focus_width"
        android:color="?attr/tvColorFocus" />
</shape>