<?xml version="1.0" encoding="utf-8"?>
<!-- Outer pill wrapping the entire top-nav menu group.
     Frosted glass + 1dp inner stroke to anchor the items visually.
     The container itself never receives focus (children intercept it),
     so it doesn't need a focused state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tv_glass" />
    <corners android:radius="@dimen/tv_radius_control" />
    <stroke android:width="1dp" android:color="?attr/tvColorOutline" />
</shape>