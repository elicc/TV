<?xml version="1.0" encoding="utf-8"?>
<!-- code.html: rounded-full bg-white/5 border border-white/10.
     Alpha colors are kept here rather than using the general glass surface:
     this navigation is deliberately darker and more neutral than cards.
     The container itself never receives focus (children intercept it),
     so it doesn't need a focused state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tv_nav_surface" />
    <corners android:radius="999dp" />
    <stroke android:width="0.5dp" android:color="@color/tv_nav_border" />
</shape>
