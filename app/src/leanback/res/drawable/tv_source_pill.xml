<?xml version="1.0" encoding="utf-8"?>
<!-- Source pill with a single precision focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_raised" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="1dp" android:color="?attr/tvColorOutline" />
        </shape>
    </item>
</selector>
