<?xml version="1.0" encoding="utf-8"?>
<!-- Outer pill for the current-source chip in the top-right of Home.
     Designed as an "info + clickable" target, not a primary navigation
     item, so the focus treatment is intentionally quieter than tv_nav_pill:
       - Background lifts from glass → tv_glass_raised (subtle elevation).
       - A single 2dp accent ring replaces the previous 3.5dp + 6dp double
         stroke so the ring reads as a selection indicator instead of
         dominating the top-right corner.
       - Text/icon colors do not need to swap (they already contrast well
         against the slightly lighter glass), keeping the pill visually
         consistent with the unfocused state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_raised" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="2dp" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass" />
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="1dp" android:color="?attr/tvColorOutline" />
        </shape>
    </item>
</selector>