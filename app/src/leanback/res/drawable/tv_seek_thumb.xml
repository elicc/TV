<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing scrubber: warm-white core ringed by a champagne halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#59FCD58B" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFE8A3" />
            <stroke
                android:width="1dp"
                android:color="#0E0E10" />
            <size
                android:width="14dp"
                android:height="14dp" />
        </shape>
    </item>
</layer-list>
