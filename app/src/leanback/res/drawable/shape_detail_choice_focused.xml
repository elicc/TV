<?xml version="1.0" encoding="utf-8"?>
<!-- A single edge-aligned stroke avoids the inset/double-ring artifact that a
     nested LayerDrawable produces on compact TV controls. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/tvColorSurfaceRaised" />
    <corners android:radius="6dp" />
    <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
    <padding android:left="10dp" android:right="10dp" android:top="7dp" android:bottom="7dp" />
</shape>
