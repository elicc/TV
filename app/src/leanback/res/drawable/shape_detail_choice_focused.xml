<?xml version="1.0" encoding="utf-8"?>
<!-- Compact controls use the shared low-profile halo plus precision ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurfaceRaised" />
            <corners android:radius="6dp" />
            <stroke android:width="@dimen/tv_glow_band" android:color="?attr/tvColorFocusGlow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
            <padding android:left="10dp" android:right="10dp" android:top="7dp" android:bottom="7dp" />
        </shape>
    </item>
</layer-list>
