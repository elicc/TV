<?xml version="1.0" encoding="utf-8"?>
<!-- Focus surface, halo band and crisp inner champagne ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="@dimen/tv_glow_band"
                android:color="?attr/tvColorFocusGlow" />
        </shape>
    </item>
    <item
        android:left="@dimen/tv_focus_stroke_offset"
        android:top="@dimen/tv_focus_stroke_offset"
        android:right="@dimen/tv_focus_stroke_offset"
        android:bottom="@dimen/tv_focus_stroke_offset">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="13dp" />
            <stroke
                android:width="@dimen/tv_focus_width"
                android:color="?attr/tvColorFocus" />
        </shape>
    </item>
</layer-list>
