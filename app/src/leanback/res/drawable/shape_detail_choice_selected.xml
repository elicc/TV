<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Keep selected and unselected choices on the same surface; the corner
         marker in the foreground carries the selection affordance. -->
    <solid android:color="?attr/tvColorSurface" />
    <corners android:radius="6dp" />
    <padding android:left="10dp" android:right="10dp" android:top="7dp" android:bottom="7dp" />
</shape>
