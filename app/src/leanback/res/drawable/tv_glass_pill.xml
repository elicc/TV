<?xml version="1.0" encoding="utf-8"?>
<!-- Glassy translucent pill. Below API 31 there is no backdrop blur, so the tint
     itself is opaque enough to read as frosted glass over dark surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/tvColorGlass" />
    <corners android:radius="@dimen/tv_radius_chip" />
    <stroke
        android:width="1dp"
        android:color="?attr/tvColorGlassBorder" />
</shape>
