<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring with an inner champagne halo stroke (oval subtitle toggle). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="@dimen/tv_glow_band" android:color="?attr/tvColorFocusGlow" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
</layer-list>
