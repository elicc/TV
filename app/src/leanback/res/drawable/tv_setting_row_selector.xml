<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurfaceRaised" />
            <corners android:radius="7dp" />
            <stroke
                android:width="2dp"
                android:color="?attr/tvColorFocus" />
            <padding
                android:bottom="5dp"
                android:left="9dp"
                android:right="9dp"
                android:top="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurface" />
            <corners android:radius="7dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/tv_border_subtle" />
            <padding
                android:bottom="6dp"
                android:left="10dp"
                android:right="10dp"
                android:top="6dp" />
        </shape>
    </item>
</selector>
