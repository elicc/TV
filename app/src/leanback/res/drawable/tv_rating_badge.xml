<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque scrim keeps the score legible over both bright and dark posters. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/tvColorScrimStrong" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/tvColorOutline" />
</shape>
