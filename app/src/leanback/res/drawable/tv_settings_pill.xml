<?xml version="1.0" encoding="utf-8"?>
<!-- Round settings button with one focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_glass" />
            <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tv_glass" />
            <stroke android:width="1dp" android:color="?attr/tvColorOutline" />
        </shape>
    </item>
</selector>
