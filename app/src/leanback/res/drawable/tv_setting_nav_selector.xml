<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <stroke android:width="@dimen/tv_glow_band" android:color="?attr/tvColorFocusGlow" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/tvColorSurface" />
                    <corners android:radius="7dp" />
                    <stroke android:width="@dimen/tv_focus_width" android:color="?attr/tvColorFocus" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorSurface" />
            <corners android:radius="7dp" />
            <stroke
                android:width="0.5dp"
                android:color="?attr/tvColorOutline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_low" />
            <corners android:radius="7dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/tv_border_subtle" />
        </shape>
    </item>
</selector>
