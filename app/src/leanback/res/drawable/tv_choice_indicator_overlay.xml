<?xml version="1.0" encoding="utf-8"?>
<!-- Current-playback marker: a restrained underline that keeps chip text
     centered and remains visible alongside the independent focus ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom|center_horizontal" android:bottom="3dp" android:width="20dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tvColorAccent" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
