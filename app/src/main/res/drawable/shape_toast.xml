<?xml version="1.0" encoding="utf-8"?>
<!-- Toast ground. Deliberately not fully opaque: the ribbon mark has no plate of its own, so
     the surface behind it has to stay legible as a surface rather than turning into a tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="22dp" />

    <solid android:color="@color/toast_background" />

</shape>
